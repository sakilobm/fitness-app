graph TD
    %% Global Store Layer
    subgraph StoreLayer ["State Management & Cache Layer"]
        useFitnessStore["Zustand Store (fitnessStore.ts)"]
        AppContext["AppContext Adapter (AppContext.tsx)"]
        StorageUtils["Storage Cache (storage.ts)"]
        
        useFitnessStore --> |"State Hydration & Persistence"| StorageUtils
        AppContext --> |"Delegates state & actions"| useFitnessStore
    end

    %% Selector Domain Hooks
    subgraph HookLayer ["Custom Domain Selector Hooks"]
        useDietTracker["useDietTracker()"]
        useWorkoutEngine["useWorkoutEngine()"]
        useHydrationTracker["useHydrationTracker()"]
        useProfileSettings["useProfileSettings()"]
        useDashboardEngine["useDashboardEngine()"]
        
        useDietTracker --> useFitnessStore
        useWorkoutEngine --> useFitnessStore
        useHydrationTracker --> useFitnessStore
        useProfileSettings --> useFitnessStore
        useDashboardEngine --> useFitnessStore
    end

    %% Navigation Gating and Authentication Stack Layer
    subgraph AuthLayer ["Authentication Route Stack ((auth))"]
        Onboarding["Onboarding (onboarding.tsx)"]
        Login["Login (login.tsx)"]
        Signup["Signup (signup.tsx)"]
        Forgot["Forgot Password (forgot.tsx)"]
    end

    subgraph GateLayer ["Navigation Security Gating"]
        NavigationGate["NavigationGate (_layout.tsx)"]
    end

    %% UI and Router Layer
    subgraph ViewLayer ["Router Navigation View Layers ((tabs))"]
        HomeTab["Home Dashboard (index.tsx)"]
        WeightTab["Weight Tracking (weight.tsx)"]
        NutritionTab["Nutrition Log (nutrition.tsx)"]
        RemindersTab["Reminders list (reminders.tsx)"]
        ProfileTab["Profile Configuration (profile.tsx)"]
    end

    %% Dynamic Component Registry
    subgraph RegistryLayer ["Dashboard Widget Registry"]
        WidgetRegistry["WidgetRegistry.tsx"]
        MetricCard["MetricCard Generic Container"]
        RadialChart["Radial Chart Widget"]
        LinearProgress["Linear Progress Widget"]
        NumericDelta["Numeric Delta Widget"]
        CompactChip["Compact Chip Widget"]

        WidgetRegistry --> MetricCard
        MetricCard --> RadialChart
        MetricCard --> LinearProgress
        MetricCard --> NumericDelta
        MetricCard --> CompactChip
    end

    %% Component Dependencies
    subgraph UILayer ["Shared Component Utilities (src/components/ui)"]
        GlassCard["GlassCard Component"]
        ScreenHeader["ScreenHeader branding"]
        AppIcon["AppIcon Vector Unified"]
        ProgressRing["ProgressRing Circle SVG"]
    end

    %% Utility Modules
    subgraph UtilLayer ["Utility Modules (src/utils)"]
        BMIUtils["bmi.ts (BMI suggestions)"]
        StepsUtils["steps.ts (step conversions)"]
        HealthCalculations["healthCalculations.ts (pure calculations)"]
    end

    %% Standalone Feature Screens
    subgraph FeatureScreens ["Feature Screens (root routes)"]
        StepsScreen["Steps & Walking (steps.tsx)"]
        WaterScreen["Hydration (water.tsx)"]
        MetabolismScreen["Metabolism (metabolism.tsx)"]
        BMIScreen["BMI Tracker (bmi.tsx)"]
    end

    %% Bidirectional Reactivity Bindings
    NavigationGate <--> |"Queries isAuthenticated"| AppContext
    NavigationGate --> |"Unauthenticated redirect"| Onboarding
    NavigationGate --> |"Authenticated redirect"| HomeTab
    
    Login --> |"Supabase Auth"| AppContext
    Signup --> |"Supabase Auth"| AppContext
    ProfileTab --> |"🚪 Log Out"| AppContext

    HomeTab <--> |"Reads via Zustand & Registry"| useDashboardEngine
    HomeTab --> |"Renders widget grid"| MetricCard
    
    WeightTab <--> |"Reads/Writes WeightLog"| AppContext
    NutritionTab <--> |"Logs food portions"| AppContext
    RemindersTab <--> |"Configures reminders CRUD"| AppContext
    ProfileTab <--> |"Updates user profile goals"| AppContext

    %% Components association
    HomeTab --> GlassCard
    WeightTab --> GlassCard
    NutritionTab --> GlassCard
    RemindersTab --> GlassCard
    
    HomeTab --> ScreenHeader
    WeightTab --> ScreenHeader
    NutritionTab --> ScreenHeader
    RemindersTab --> ScreenHeader
    
    GlassCard --> AppIcon
    ScreenHeader --> AppIcon

    %% Custom SVG widgets
    WeightTab --> SparkLine["SVG SparkLine Plotter"]
    WeightTab --> ProgressRing
    HomeTab --> ProgressRing

    %% Feature screen bindings
    StepsScreen <--> |"useWorkoutEngine()"| useWorkoutEngine
    BMIScreen <--> |"bmiLogs, currentBMI"| AppContext
    
    StepsScreen --> StepsUtils
    StepsScreen --> BMIUtils
    BMIScreen --> BMIUtils
    BMIScreen --> HealthCalculations
    
    HomeTab --> BMIScreen
    HomeTab --> StepsScreen
